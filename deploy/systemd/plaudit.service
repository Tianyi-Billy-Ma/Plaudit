# ~/.config/systemd/user/plaudit.service: one run per start, in a capped container. Pair with plaudit.timer.
# Secrets come from ~/.config/plaudit.env (mode 600, KEY=value lines, see README) and are passed into the container
# as environment variables. Fetching them from a secret manager on every tick is not worth it: 1Password's daily
# quota was exhausted that way (2026-10-15), and these values rarely change.
[Unit]
Description=Plaudit: pull new recordings and process the queue once

[Service]
Type=oneshot
TimeoutStartSec=3h
WorkingDirectory=%h/plaudit
EnvironmentFile=%h/.config/plaudit.env
ExecStart=/usr/bin/docker run --rm --gpus all --memory=7g --memory-swap=7g \
  -e PLAUDIT_SUMMARY_API_KEY -e NOTION_TOKEN \
  -v %h/plaudit:/plaudit -v %h/.plaud:/root/.plaud -v %h/.config/rclone:/root/.config/rclone:ro \
  -v %h/.cache/huggingface:/root/.cache/huggingface -v /etc/localtime:/etc/localtime:ro \
  plaudit:0.1.0 run
