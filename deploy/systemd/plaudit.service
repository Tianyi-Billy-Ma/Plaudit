# ~/.config/systemd/user/plaudit.service: one run per start, in a capped container. Pair with plaudit.timer.
# Secrets: ~/.config/secrets.env holds only the 1Password bootstrap (OP_SERVICE_ACCOUNT_TOKEN, OP_ENVIRONMENT_ID;
# mode 600, also sourced by ~/.bashrc). `op run --environment` fetches the 1Password "Agent" environment at start
# and the named variables are passed into the container; no application secret is written to disk.
[Unit]
Description=Plaudit: pull new recordings and process the queue once

[Service]
Type=oneshot
TimeoutStartSec=3h
WorkingDirectory=%h/plaudit
# 1Password rate-limits Environment reads (hit after a day of one call per 5 min), so secrets are fetched only
# when a job actually waits; pulling from Plaud and backing up need none. A failed op call (rate limit, outage)
# leaves data/op-failed and op is not tried again for an hour, otherwise the waiting job would retry it every
# 5 min and keep the quota exhausted (2026-10-14).
ExecStart=/bin/bash -c 'D="/usr/bin/docker run --rm --gpus all --memory=7g --memory-swap=7g \
  -v %h/plaudit:/plaudit -v %h/.plaud:/root/.plaud -v %h/.config/rclone:/root/.config/rclone:ro \
  -v %h/.cache/huggingface:/root/.cache/huggingface -v /etc/localtime:/etc/localtime:ro"; F=%h/plaudit/data/op-failed; \
  $$D plaudit:0.1.0 pull && if $$D plaudit:0.1.0 status | grep -q "  waiting " && [ -z "$$(find $$F -mmin -60 2>/dev/null)" ]; then \
    . %h/.config/secrets.env && %h/.local/bin/op run --environment "$$OP_ENVIRONMENT_ID" --no-masking -- \
      $$D -e PLAUDIT_SUMMARY_API_KEY -e NOTION_TOKEN plaudit:0.1.0 run && rm -f $$F || { touch $$F; exit 1; }; \
  else exec $$D plaudit:0.1.0 run; fi'
