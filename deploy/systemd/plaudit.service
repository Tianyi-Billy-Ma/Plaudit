# ~/.config/systemd/user/plaudit.service: one run per start, in a capped container. Pair with plaudit.timer.
# Secrets come from ~/.config/secrets.env (mode 600, KEY=value lines, see README) and are passed into the container
# as environment variables. Do not fetch them from a secret manager on every tick: 288 reads a day for values that
# never change is how a daily API quota gets exhausted.
[Unit]
Description=Plaudit: pull new recordings and process the queue once

[Service]
Type=oneshot
TimeoutStartSec=8h
WorkingDirectory=%h/plaudit
# Sourced by a shell, not EnvironmentFile=: systemd rejects `export KEY=value` lines and logs them, secret and all.
ExecStart=/bin/bash -c 'set -a; . %h/.config/secrets.env; set +a; exec /usr/bin/docker run --rm --gpus all \
  --memory=7g --memory-swap=7g -e OPENAI_API_KEY -e NOTION_TOKEN -e PLAUDIT_ASR_API_KEY \
  -e PLAUDIT_WEBHOOK_URL -e PLAUDIT_SMTP_USER -e PLAUDIT_SMTP_PASSWORD \
  -v %h/plaudit:/plaudit -v %h/.plaud:/root/.plaud -v %h/.config/rclone:/root/.config/rclone:ro \
  -v %h/.cache/huggingface:/root/.cache/huggingface -v /etc/localtime:/etc/localtime:ro \
  plaudit:0.1.0 run'
